# Campus Buzz – Backend Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# Set to 'production' on your hosting platform (Render, Railway, etc.)
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
# Get this from: https://cloud.mongodb.com → your cluster → Connect
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/campusbuzz?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a random, hard-to-guess string of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL(s) your frontend is served from.
# In development: http://localhost:3000
# In production:  https://your-app.vercel.app
# Multiple origins can be comma-separated: https://app.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000

# ── SMTP (Email Sending) ──────────────────────────────────────────────────────
# Used for OTP verification emails and password-reset links.
# Recommended: Gmail with an App Password (not your main Gmail password).
# How to get a Gmail App Password:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Create an app password → copy the 16-character code below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_gmail_address@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
FROM_NAME=CampusBuzz
FROM_EMAIL=noreply@campusbuzz.com

# ─────────────────────────────────────────────────────────────────────────────
# CONTENT MODERATION  (utils/moderation)
# ─────────────────────────────────────────────────────────────────────────────
# NLP pipeline that screens every post on create and edit, for all three roles.
#
#   0 normalise    ~0ms   defeat leetspeak / spacing / homoglyph evasion
#   1 lexical      ~1ms   rules + Hinglish lexicon + contact/scam/spam detection
#   2 sentiment    ~1ms   AFINN-165 tone and target
#   3 classifier  ~10ms   pretrained transformer, runs locally. FREE. Always on.
#   4 Claude     ~500ms   optional, paid, off unless a key is set

# enforce | shadow | off
#   enforce blocks violations outright. shadow computes and stores every verdict
#   but never blocks — switch to it for a week if you want to tune the
#   thresholds below against your own traffic before enforcing.
MODERATION_MODE=enforce

# Roles the pipeline applies to. Comma-separated. All three by default —
# a Club or Admin account posting a slur is the same problem as a student one.
MODERATION_ROLES=Student,Club,Admin

# Score thresholds, 0.0-1.0. Post is rejected at BLOCK_AT, published-and-queued
# at FLAG_AT. Keep BLOCK_AT high: a wrongly blocked #foodsplit post costs more
# trust than a wrongly published one, which readers can still report.
MODERATION_BLOCK_AT=0.80
MODERATION_FLAG_AT=0.45

# Gray band that escalates to the LLM tier. Outside this range the cheap tiers
# are confident enough on their own and no model call is made.
MODERATION_GRAY_LOW=0.30
MODERATION_GRAY_HIGH=0.85

# AFINN comparative score at or below which the tone counts as hostile.
MODERATION_SENTIMENT_AT=-0.6
MODERATION_SENTIMENT_MIN_TOKENS=4

# ── Tier 3: local transformer classifier (FREE) ──────────────────────────────
# Weights are downloaded once from Hugging Face into backend/.models (gitignored)
# and then run on the CPU in-process. No API key, no per-request cost, and no
# post text ever leaves the server.
MODERATION_ML_ENABLED=true

# KoalaAI/Text-Moderation — DeBERTa-v3, 9 labels covering sexual (S/S3),
# self-harm (SH), hate (H/H2), violence (V/V2) and harassment (HR).
# Measured on this repo's test set: ~403 MB RSS, ~8 ms per post, and no false
# positives on profane-but-legitimate complaints.
MODERATION_ML_MODEL=KoalaAI/Text-Moderation

# Optional second model: Xenova/toxic-bert. Better recall on direct insults and
# threats, but the two together measured 522 MB RSS — over a 512 MB host.
# Enable only where 1 GB or more is available.
MODERATION_ML_SECONDARY=false
MODERATION_ML_SECONDARY_MODEL=Xenova/toxic-bert

# q8 measured best. Do not use q4: it was less accurate on borderline posts AND
# larger at runtime (805 MB), because 4-bit blocks dequantize in memory.
MODERATION_ML_DTYPE=q8

# Where weights are cached, and whether to load them at boot. Leave warmup on:
# without it the first student to post pays the model load.
# MODERATION_ML_CACHE=./.models
MODERATION_ML_WARMUP=true

# ── Tier 4: Claude (OPTIONAL, PAID, off by default) ──────────────────────────
# The pipeline is fully functional without this. It exists only to close the two
# gaps the free tiers measurably have: romanised Hindi abuse the transformer
# cannot read, and harassment by implication that uses no flaggable words.
# Leave ANTHROPIC_API_KEY blank to keep the whole system free.
ANTHROPIC_API_KEY=
MODERATION_LLM_ENABLED=true
MODERATION_LLM_MODEL=claude-opus-5
MODERATION_LLM_TIMEOUT_MS=6000
MODERATION_LLM_MAX_TOKENS=2048

# Log clean verdicts too. Needed while tuning in shadow mode; noisy afterwards.
# Post text is never logged either way — only ids and scores.
MODERATION_LOG_ALL=false
